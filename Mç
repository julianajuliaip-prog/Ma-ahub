	base_name_patterns = { "base", "pen", "hatch", "deposit", "dropoff" },
	steal_action_keys  = { "steal", "roubar", "take", "grab" }, -- ActionText do prompt

	carry_speed     = 65,
	default_speed   = 16,
	auto_return_interval = 0.5,
	auto_grab_interval   = 0.12,
	radar_range          = 700,
}

-- ============ HELPERS ============
local function has_any(s, list)
	s = string.lower(s)
	for _, p in ipairs(list) do
		if string.find(s, p, 1, true) then return true end
	end
	return false
end

local function get_char() return player.Character or player.CharacterAdded:Wait() end

local function get_hum()
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function get_root()
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

-- varredura de workspace com profundidade limitada
local function scan_parts(pattern_list, only_prompt)
	local out, seen = {}, {}
	local function walk(node, depth)
		if depth > 5 or seen[node] then return end
		seen[node] = true
		for _, obj in ipairs(node:GetChildren()) do
			if obj:IsA("BasePart") then
				local match = has_any(obj.Name, pattern_list)
				if only_prompt then
					local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
					if prompt and has_any(prompt.ActionText, CONFIG.steal_action_keys) then
						match = true
					end
				end
				if match then table.insert(out, obj) end
			else
				walk(obj, depth + 1)
			end
		end
	end
	walk(workspace, 0)
	return out
end

local function find_eggs()
	return scan_parts(CONFIG.egg_name_patterns, true)
end

local function find_base()
	local team = player.Team
	local bases = scan_parts(CONFIG.base_name_patterns, false)
	if team then
		for _, b in ipairs(bases) do
			if b.BrickColor == team.TeamColor then return b end
		end
	end
	return bases[1]
end

-- detecção de carry: speed caiu = está com ovo
local function carrying_egg()
	local hum = get_hum()
	if not hum then return false end
	if hum.WalkSpeed < (CONFIG.default_speed - 2) then return true end
	-- fallback: alguma parte "egg" presa no personagem
	local ch = player.Character
	if not ch then return false end
	for _, d in ipairs(ch:GetDescendants()) do
		if d:IsA("BasePart") and has_any(d.Name, CONFIG.egg_name_patterns) then
			return true
		end
	end
	return false
end

-- ============ ESTADO ============
local state = {
	speed_carry = false,
	auto_return = false,
	auto_grab   = false,
	anti_stun   = false,
	radar       = false,
}

local stats = { grabs = 0, returns = 0 }
local last_grab = 0

-- ============ AÇÕES ============
local function grab_nearest_egg()
	local hrp = get_root()
	if not hrp then return end
	local eggs = find_eggs()
	if #eggs == 0 then return end

	local best, best_d
	for _, e in ipairs(eggs) do
		if e:IsDescendantOf(workspace) then
			local d = (hrp.Position - e.Position).Magnitude
			if not best_d or d < best_d then best, best_d = e, d end
		end
	end
	if not best then return end

	local prompt = best:FindFirstChildOfClass("ProximityPrompt")
	if prompt and fireproximityprompt then
		pcall(fireproximityprompt, prompt)
		stats.grabs = stats.grabs + 1
		last_grab = os.clock()
	end
end

local function tp_nearest_egg()
	local hrp = get_root()
	if not hrp then return end
	local eggs = find_eggs()
	local best, best_d
	for _, e in ipairs(eggs) do
		if e:IsDescendantOf(workspace) then
			local d = (hrp.Position - e.Position).Magnitude
			if not best_d or d < best_d then best, best_d = e, d end
		end
	end
	if best then hrp.CFrame = best.CFrame + Vector3.new(0, 4, 0) end
end

local function return_to_base()
	local hrp  = get_root()
	local base = find_base()
	if hrp and base then
		hrp.CFrame = base.CFrame + Vector3.new(0, 4, 0)
		stats.returns = stats.returns + 1
	end
end

-- ============ LOOPS ============
RunService.Heartbeat:Connect(function()
	local hum = get_hum()
	if not hum then return end

	if state.speed_carry then
		if carrying_egg() then
			if hum.WalkSpeed < CONFIG.carry_speed then
				hum.WalkSpeed = CONFIG.carry_speed
			end
		elseif hum.WalkSpeed ~= CONFIG.default_speed then
			hum.WalkSpeed = CONFIG.default_speed
		end
	end

	if state.anti_stun then
		local s = hum:GetState()
		if s == Enum.HumanoidStateType.FallingDown
			or s == Enum.HumanoidStateType.PlatformStanding
			or s == Enum.HumanoidStateType.Ragdoll then
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end
end)

task.spawn(function()
	while task.wait(CONFIG.auto_grab_interval) do
		if state.auto_grab and os.clock() - last_grab > 0.2 then
			pcall(grab_nearest_egg)
		end
	end
end)

task.spawn(function()
